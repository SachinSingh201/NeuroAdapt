# Backend Configuration
EMOTION_MODE="auto"  # cloud, local, auto
DEBUG_MODE=false

# Cloud Emotion API Configuration
EMOTION_API_URL="https://serverless.roboflow.com"
EMOTION_API_KEY="your_api_key_here"
EMOTION_API_METHOD="POST"
EMOTION_API_IMAGE_FIELD="image"

# Roboflow Sitting Posture Classification (Cloud)
ROBOFLOW_API_KEY="your_roboflow_api_key_here"
ROBOFLOW_WORKSPACE="your_workspace_id"
ROBOFLOW_WORKFLOW_ID="your_workflow_id"

# Local Model Configuration
LOCAL_MODEL_PATH="backend/models/emotion_cnn.pkl"

# Project Metadata
PROJECT_NAME="NeuroAdapt"
VERSION="1.0.0"

# Adaptation Settings
PROCESSING_INTERVAL_MS=3000
MIN_CONFIDENCE_THRESHOLD=0.55
STABLE_PREDICTIONS_REQUIRED=3
TEMPORAL_WINDOW_SIZE=5
